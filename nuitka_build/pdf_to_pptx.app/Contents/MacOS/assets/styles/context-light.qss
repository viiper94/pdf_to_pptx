
/* Style for the QMenu container itself */
QMenu {
    background-color: #fafafa;
    border: 1px solid #cccccc;
	border-radius: 2px;
}

/* Style for a normal menu item */
QMenu::item {
    color: #1e1e1e;
    background-color: transparent;
    padding: 3px 10px;
    margin: 3px 2px;
}

/* Style for a normal menu item when it's selected or hovered */
QMenu::item:selected {
    background-color: #d9d9d9;
    border-radius: 4px;
}

/* Style for the menu headers (which are disabled QActions) */
QMenu::item:disabled {
    color: #888888;
    background-color: transparent;
    font-weight: bold;
    padding: 0px 10px 3px 10px;
}

/* Add a separator line style */
QMenu::separator {
    height: 1px;
    background-color: #cccccc;
    margin: 5px 5px;
}