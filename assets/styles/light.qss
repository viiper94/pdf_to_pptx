/* =================================================================== */
/* General & Base Styles (Light Theme)
/* =================================================================== */
QWidget {
	font-family: "Consolas", Arial, sans-serif;
	background-color: #eeeef0;
}

#widgetDrag{
    background-color: rgba(31, 111, 184, 0.06);
}

QLabel {
	color: #1a1a1e;
	background-color: transparent;
	border: none;
}

QScrollArea {
    border: none;
}

#mainLabel {
	font-size: 15px;
}


/* =================================================================== */
/* File Frame Styles
/* =================================================================== */

/* --- Base properties for ALL file frames --- */
#fileFrame,
#fileFrameConverting,
#fileFrameFinished,
#fileFrameFailed,
#fileFrameProcessing,
#fileFrameCanceled {
	margin: 0;
	padding: 0;
}

/* --- Specific background/border colors for each frame state --- */
#fileFrame {
    background-color: transparent;
    border: 1px solid #d0d0d5;
}

#fileFrameCanceled {
    background-color: transparent;
    border: 1px solid #999999;
}

#fileFrameConverting,
#fileFrameProcessing {
    background-color: transparent;
    border: 1px solid #3d85c6;
}

#fileFrameFinished {
    background-color: transparent;
    border: 1px solid #6aa84f;
}

#fileFrameFailed {
    background-color: transparent;
    border: 1px solid #cc0000;
}


/* =================================================================== */
/* Labels within File Frame
/* =================================================================== */
#fileName {
	font-size: 14px;
	font-weight: 500;
	color: #1a1a1e;
}

#fileSize{
	font-size: 12px;
	color: #6e6e73;
}

#fileStatus,
#fileStatusCanceled {
	color: #6e6e73;
}

#fileStatusProcessing,
#fileStatusConverting {
	color: #1f6fb8;
}

#fileStatusFailed {
	color: #c23b3a;
}

#fileStatusFinished {
	color: #4b7a1a;
}


/* =================================================================== */
/* Badge
/* =================================================================== */
#fileBadge,
#fileBadgeCanceled {
	background-color: rgba(0, 0, 0, 0.05);
	border: none;
}

#fileBadgeProcessing,
#fileBadgeConverting{
    background: rgba(31, 111, 184, 0.10);
}

#fileBadgeFinished {
    background: rgba(75, 122, 26, 0.10);
}

#fileBadgeFailed {
    background: rgba(194, 59, 58, 0.10);
}


/* =================================================================== */
/* Progress Bar
/* =================================================================== */
QProgressBar,
QProgressBar#fileProgressCanceled::chunk {
	background-color: #6e6e73;
	border: none;
}

QProgressBar#fileProgressProcessing::chunk,
QProgressBar#fileProgressConverting::chunk{
    background: #1f6fb8;
}

QProgressBar#fileProgressFinished::chunk {
    background: #4b7a1a;
}

QProgressBar#fileProgressFailed::chunk {
    background: #c23b3a;
}

/* =================================================================== */
/* Menu & Menu Bar Styles
/* =================================================================== */

/* --- Menu Bar (the top bar holding the menu names) --- */
QMenuBar {
    background-color: #f0f0f0;
    border-bottom: 1px solid #cccccc;
    padding-left: 3px;
}

/* Style for the top-level menu names */
QMenuBar::item {
    color: #1e1e1e;
    background-color: transparent;
    padding: 5px 10px;
}

/* Style for a top-level menu name when it's hovered or clicked */
QMenuBar::item:selected {
    background-color: #fff;
    border-radius: 0px;
    border: 1px solid #d0d0d5;
    border-bottom: none;
    border-top: none;
}

/* Style for the QMenu container itself */
QMenu {
    background-color: #fafafa;
    border: 1px solid #cccccc;
	border-radius: 0px;
    margin-top: 0px;
    padding-top: 0px;
}

/* Style for a normal menu item */
QMenu::item {
    color: #1e1e1e;
    background-color: transparent;
    padding: 5px 10px;
    margin: 0px 0px;
}

/* Style for a normal menu item when it's selected or hovered */
QMenu::item:selected {
    background-color: #d9d9d9;
    border-radius: 0px;
}

/* Style for the menu headers (which are disabled QActions) */
QMenu::item:disabled {
    color: #888;
    background-color: transparent;
    font-weight: bold;
    padding: 5px 10px 3px 10px;
}

/* Add a separator line style */
QMenu::separator {
    height: 1px;
    background-color: #cccccc;
    margin: 0;
}


/* =================================================================== */
/* ToolButton Styles
/* =================================================================== */
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0px;
}