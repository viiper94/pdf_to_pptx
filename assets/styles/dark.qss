/* =================================================================== */
/* General & Base Styles
/* =================================================================== */
QWidget {
	background-color: #2a2a2a;
}

#widgetDrag{
    background-color: #3A3A3A;
}

QLabel {
	color: #E6E6E6;
	background-color: transparent; /* Set transparency once for all labels */
	border: none;
}

QScrollArea{
    border: none;
}

#mainLabel {
	font-size: 15px;
	font-family: Helvetica, "Segoe UI", Arial, sans-serif; /* Corrected typo and added fallbacks */
}

/* =================================================================== */
/* File Frame Styles
/* =================================================================== */

/* --- Base properties for ALL file frames --- */
#fileFrame,
#fileFrameConverting,
#fileFrameFinished,
#fileFrameFailed {
	border-radius: 10px;
	margin: 0;
	padding: 0;
}

/* --- Specific background/border colors for each frame state --- */
#fileFrame {
	background-color: #333;
}

#fileFrameConverting {
    border: 1px solid #e9a222;
	background-color: #3A3A3A;
}

#fileFrameFinished {
	background-color: #334733;
}

#fileFrameFailed {
	background-color: #4A3333;
}

/* =================================================================== */
/* Labels within File Frame
/* =================================================================== */
#fileName {
	font-size: 16px;
	max-width: 270px;
}

#fileSize,
#fileSlides {
	color: #707070;
}

#fileStatus {
	color: #89898b;
}

#fileStatusProcessing {
	color: #e9a222;
}

/* --- Grouped selectors for labels with the same color --- */
#fileStatusFailed,
#fileStatusCanceled,
#fileStatusConverting {
	color: #da1039;
}

#fileStatusFinished {
	color: #00bb00;
}

/* =================================================================== */
/* Progress Bar
/* =================================================================== */
QProgressBar {
	background-color: #424242;
	border: none;
	max-width: 170px;
	min-width: 170px;
	text-align: center;
	color: #eee;
	border-radius: 5px;
	height: 25px;
}

QProgressBar::chunk {
	background-color: #007700; /* Using a consistent hex code for green */
	border-radius: 5px;
}

/* =================================================================== */
/* Menu Styles
/* =================================================================== */

/* --- Menu Bar (the top bar holding the menu names) --- */
QMenuBar {
    background-color: #2a2a2a; /* Match the main window background */
    border-bottom: 1px solid #424242; /* Adds a subtle separator line */
    padding: 3px;
}

/* Style for the top-level menu names */
QMenuBar::item {
    color: #E6E6E6;
    background-color: transparent;
    padding: 5px 10px; /* Give the names some breathing room */
}

/* Style for a top-level menu name when it's hovered or clicked */
QMenuBar::item:selected {
    background-color: #333;
    border-radius: 4px;
}

/* Style for the QMenu container itself */
QMenu {
    background-color: #333;
    border: 1px solid #424242; /* A subtle border helps it stand out */
	border-radius: 5px;
    margin-top: 3px;
    padding-top: 3px;
}

/* Style for a normal menu item */
QMenu::item {
    color: #e6e6e6;
    background-color: transparent;
    padding: 3px 10px;
    margin: 3px 2px;
}

/* Style for a normal menu item when it's selected or hovered */
QMenu::item:selected {
    background-color: #4a4a4a;
    border-radius: 4px;
}

/* Style for the menu headers (which are disabled QActions) */
QMenu::item:disabled {
    color: #888; /* Use a distinct color for headers */
    background-color: transparent; /* Ensure it can't be selected */
    font-weight: bold;
    padding: 0px 10px 3px 10px;
}

/* Add a separator line style */
QMenu::separator {
    height: 1px;
    background-color: #424242;
    margin: 5px 5px;
}