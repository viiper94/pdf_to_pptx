/* =================================================================== */
/* General & Base Styles
/* =================================================================== */
QWidget {
	font-family: "Consolas", Arial, sans-serif;
	background-color: #2a2a2a;
}

#widgetDrag{
    background-color: #3A3A3A;
}

QLabel {
	color: #E6E6E6;
	background-color: transparent; /* Set transparency once for all labels */
	border: none;
}

QScrollArea{
    border: none;
}

#mainLabel {
	font-size: 15px;
}


/* =================================================================== */
/* File Frame Styles
/* =================================================================== */

/* --- Base properties for ALL file frames --- */
#fileFrame,
#fileFrameConverting,
#fileFrameFinished,
#fileFrameFailed,
#fileFrameProcessing,
#fileFrameCanceled {
	margin: 0;
	padding: 0;
}

/* --- Specific background/border colors for each frame state --- */
#fileFrame,
#fileFrameCanceled{
	border: 1px solid rgba(255, 255, 255, 0.12);
}

#fileFrameConverting,
#FileFrameProcessing {
    border: 1px solid rgba(55, 138, 221, 0.35);
}

#fileFrameFinished {
    border: 1px solid rgba(99, 153, 34, 0.5);
}

fileFrameFailed {
    border: 1px solid rgba(226, 75, 74, 0.4);
}


/* =================================================================== */
/* Labels within File Frame
/* =================================================================== */
#fileName {
	font-size: 14px;
	font-weight: 500;
	color: #f0f0f0;
}

#fileSize{
	font-size: 12px;
	color: #8a8a8e;
}

#fileStatus,
#fileStatusCanceled {
	color: #8a8a8e;
}

#fileStatusProcessing,
#fileStatusConverting {
	color: #378add;
}

#fileStatusFailed {
	color: #e24b4a;
}

#fileStatusFinished {
	color: #639922;
}


/* =================================================================== */
/* Badge
/* =================================================================== */
#fileBadge,
#fileBadgeCanceled {
	background-color: rgba(255, 255, 255, 0.05);
	border: none;
}

#fileBadgeProcessing,
#fileBadgeConverting{
    background: rgba(55, 138, 221, 0.08);
}

#fileBadgeFinished {
    background: rgba(99, 153, 34, 0.08);
}

#fileBadgeFailed {
    background: rgba(226, 75, 74, 0.08);
}


/* =================================================================== */
/* Progress Bar
/* =================================================================== */
QProgressBar,
QProgressBar#fileProgressCanceled::chunk {
	background-color: rgba(255, 255, 255, 0.08);
	border: none;
}

QProgressBar#fileProgressProcessing::chunk,
QProgressBar#fileProgressConverting::chunk{
    background: #378add;
}

QProgressBar#fileProgressFinished::chunk {
    background: #639922;
}

QProgressBar#fileProgressFailed::chunk {
    background: #e24b4a;
}


/* =================================================================== */
/* Menu Styles
/* =================================================================== */

/* --- Menu Bar (the top bar holding the menu names) --- */
QMenuBar {
    background-color: #2a2a2a; /* Match the main window background */
    border-bottom: 1px solid #424242; /* Adds a subtle separator line */
    padding-left: 3px;
}

/* Style for the top-level menu names */
QMenuBar::item {
    color: #E6E6E6;
    background-color: transparent;
    padding: 5px 10px; /* Give the names some breathing room */
}

/* Style for a top-level menu name when it's hovered or clicked */
QMenuBar::item:selected {
    background-color: #333;
    border-radius: 0px;
    border: 1px solid #424242;
    border-bottom: none;
    border-top: none;
}

/* Style for the QMenu container itself */
QMenu {
    background-color: #333;
    border: 1px solid #424242; /* A subtle border helps it stand out */
	border-radius: 0px;
    margin-top: 0px;
    padding-top: 3px;
}

/* Style for a normal menu item */
QMenu::item {
    color: #e6e6e6;
    background-color: transparent;
    padding: 5px 10px;
    margin: 0px 0px;
}

/* Style for a normal menu item when it's selected or hovered */
QMenu::item:selected {
    background-color: #4a4a4a;
    border-radius: 0px;
}

/* Style for the menu headers (which are disabled QActions) */
QMenu::item:disabled {
    color: #888; /* Use a distinct color for headers */
    background-color: transparent; /* Ensure it can't be selected */
    font-weight: bold;
    padding: 5px 10px 3px 10px;
}

/* Add a separator line style */
QMenu::separator {
    height: 1px;
    background-color: #424242;
    margin: 0;
}

/* =================================================================== */
/* ToolButton Styles
/* =================================================================== */
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0px;
}


/* =================================================================== */
/* Logs Window Styles
/* =================================================================== */
QPlainTextEdit {
    background-color: transparent;
    color: #E6E6E6;
    border: none
}


/* =================================================================== */
/* Dialog Styles
/* =================================================================== */
QMessageBox {
    background-color: #2a2a2a;
    color: #E6E6E6;
    border: none;
}

QMessageBox QPushButton {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #444;
    padding: 6px 16px;
    min-width: 80px;
    border-radius: 0px;
}

QMessageBox QPushButton:hover {
    background-color: #3c3c3c;
}

QMessageBox QPushButton:pressed {
    background-color: #1e1e1e;
}
